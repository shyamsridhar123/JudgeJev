# Required for fresh Jev evaluations. Obtain your own key from TypeSafe.
TYPESAFE_API_KEY=

# Optional: a provider implementing POST /responses with this exact model ID.
# Fixed answer evaluation needs only the TypeSafe key above.
GENERATOR_BASE_URL=
GENERATOR_MODEL=
GENERATOR_API_KEY=
# Optional; omit unless supported by your generator.
GENERATOR_REASONING_EFFORT=

# Optional persistent local ledger directory. Never publish its contents.
JUDGEJEV_DATA_DIR=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
